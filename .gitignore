# 系统文件
.DS_Store
Thumbs.db

# 内部工作文档（含飞书云盘链接、运营 Prompt，不公开）
*.md
*.md.txt
*.txt

# 但 llms.txt / robots.txt 是站点发布所需的机器可读索引与爬虫规则，需保留
!llms.txt
!robots.txt
# tools/README.txt 是构建流程说明，需随仓库提交（不忽略）
!tools/README.txt

# 设计源文件
海鑫汇.ai

# 历史备份副本
backup/

# 活动图片墙：源图 + 内部预览页 + 拼图脚本（素材/工具区，不部署到线上）
clients/footprints/

# 本地环境变量 / 密钥
.env
*.key
*.pem

# 演示 / 草稿页（_demo 文件夹及内部文件，不部署到对外网站）
_demo/

# 图片压缩原图备份（本地回退用，不部署）
_img_backup/

# Node 依赖（sharp 等本地工具，不进版本库）
node_modules/

